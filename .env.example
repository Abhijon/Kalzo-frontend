# Public (safe for Vercel "Build" env — baked into the client bundle)
VITE_API_BASE_URL=https://YOUR-RAILWAY-HOST/api/v1
VITE_API_PROXY_TARGET=https://YOUR-RAILWAY-HOST

# Optional public client knobs
# VITE_SUREPASS_GATEWAY=

# Server-only — set in Vercel Project → Settings → Environment Variables
# Never prefix secrets with VITE_
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_LIVE_KEY_ID=
# RAZORPAY_LIVE_KEY_SECRET=
# KALZO_PAYMENTS=
# KALZO_PAYMENT_TESTERS=
# LOVABLE_API_KEY=
# LOVABLE_SEND_URL=
# LOVABLE_CRON_SECRET=
